# Cove Bridge
NODE_ENV=production
PORT=8787

# Public HTTPS origin only, without /mcp.
# Required for MCP App CSP and Listener SSE.
BRIDGE_PUBLIC_ORIGIN=https://bridge.example.com

# Required. Protects /mcp and /mcp/music with Authorization: Bearer <token>.
# Generate a long random value and store the same value in the MCP client's secure headers.
MCP_ACCESS_TOKEN=change-me-to-a-long-random-value

# Optional generic /events protection.
BRIDGE_INGEST_TOKEN=change-me-to-a-different-long-random-value

# Optional Unix socket. Leave empty when reverse proxying to 127.0.0.1:8787.
BRIDGE_UNIX_SOCKET=

# NetEase Listen Together
TOGETHER_ENABLED=true
TOGETHER_POLL_INTERVAL_MS=4000
TOGETHER_HEARTBEAT_INTERVAL_MS=10000

# Optional: only handle invitations from one account.
NETEASE_INVITER_UID=

# Keep this secret. At minimum it should contain MUSIC_U.
NETEASE_COOKIE=MUSIC_U=replace-with-your-own-session-cookie
